# ---- LLM provider -----------------------------------------------------------
# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- Auth -------------------------------------------------------------------
# Privy app id — access tokens from the iOS app are verified against this.
PRIVY_APP_ID=cmmgig83e01nd0ci84srkxo22
# Set to "true" ONLY for local development. Never in production.
AUTH_DISABLED=false

# ---- Upstream data ----------------------------------------------------------
# Optional CoinGecko Pro/Demo key. Without one the free tier limits apply.
COINGECKO_API_KEY=
COINGECKO_PLAN=free

# ---- Server -----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Per-user chat requests allowed per rolling minute.
USER_RATE_LIMIT_PER_MIN=12
