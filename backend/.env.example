# ---- LLM provider -----------------------------------------------------------
# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- Auth -------------------------------------------------------------------
# Privy app id — access tokens from the iOS app are verified against this.
PRIVY_APP_ID=cmmgig83e01nd0ci84srkxo22
# Set to "true" ONLY for local development. Never in production.
AUTH_DISABLED=false

# ---- Upstream data ----------------------------------------------------------
# Optional CoinGecko Pro/Demo key. Without one the free tier limits apply.
COINGECKO_API_KEY=
COINGECKO_PLAN=free

# ---- Server -----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Per-user chat requests allowed per rolling minute.
USER_RATE_LIMIT_PER_MIN=12

# ---- Using a non-OpenAI, OpenAI-compatible provider -------------------------
# Set LLM_PROVIDER=openai and point OPENAI_BASE_URL at the provider. Examples:
#   Groq        https://api.groq.com/openai/v1        (llama-3.3-70b-versatile)
#   DeepSeek    https://api.deepseek.com/v1           (deepseek-chat)
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   xAI         https://api.x.ai/v1                   (grok-4)
#   Ollama      http://localhost:11434/v1             (any local tool-calling model)
# The model MUST support function calling, or the analyst has no tools and
# will fall back to guessing — which is the failure this backend exists to fix.
OPENAI_BASE_URL=
