{
  "name": "portl-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PortL AI analyst backend \u2014 holds provider keys, runs the tool-calling loop, streams to the iOS app.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "accuracy": "node --env-file=.env --experimental-strip-types test/accuracy.ts",
    "trader": "node --env-file=.env --experimental-strip-types test/trader.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "jose": "^6.1.0",
    "openai": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.0"
  }
}
